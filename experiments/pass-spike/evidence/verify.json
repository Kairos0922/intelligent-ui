  "findings": [
    {
      "id": "F1",
      "title": "Conclusion text and cached artifact can disagree",
      "detail": "Offline answer prose still says D7 while the answer also shows \"D2\" as the last known gate. Prose is a separate op with no structured slot or freshness binding.",
      "evidence": "You're checked in for MR 284 to Lisbon. Boarding starts at 19:05 at Gate D7.MRMeridian AirBoarding passPASScred_8f3a2c71VerifiedSaved copyOfflineChecked this minuteAMSAmsterdam19:3"
    },
    {
      "id": "F2",
      "title": "Local snapshot tampering is undetectable",
      "detail": "Changing the gate in localStorage leaves integrity=Verified and freshness=Saved copy. Offline snapshot integrity needs a signature or host-sealed digest; the SDK has neither."
    },
    {
      "id": "F3",
      "title": "Props cannot be bound to a trusted verifier",
      "detail": "A model can write integrity=verified, producer=issuer and any signature string. Only the host-side attestation store prevented a false badge, and it needed an explicit credentialId match to avoid lending a previous pass its status. The store is not part of the protocol; a different host would rebuild it."
    },
    {
      "id": "F4",
      "title": "Answer-level locale has no protocol carrier",
      "detail": "The host passes locale in block props and writes a second localized conclusion op. Built-in SDK chrome and the action envelope remain English."
    }
  ],
