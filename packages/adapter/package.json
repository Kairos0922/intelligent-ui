{
  "name": "@intelligent-ui/adapter",
  "version": "0.2.2",
  "type": "module",
  "description": "Host-neutral bridge between the Intelligent UI core runtime and an agent adapter.",
  "license": "MIT",
  "author": "Intelligent UI contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kairos0922/intelligent-ui.git",
    "directory": "packages/adapter"
  },
  "homepage": "https://github.com/Kairos0922/intelligent-ui#readme",
  "bugs": {
    "url": "https://github.com/Kairos0922/intelligent-ui/issues"
  },
  "keywords": [
    "intelligent-ui",
    "agent",
    "host-adapter",
    "ui"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@intelligent-ui/core": "0.2.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
