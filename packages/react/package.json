{
  "name": "@intelligent-ui/react",
  "version": "0.2.2",
  "type": "module",
  "description": "React wrapper for the Intelligent UI runtime with StrictMode-safe mounting.",
  "license": "MIT",
  "author": "Intelligent UI contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kairos0922/intelligent-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Kairos0922/intelligent-ui#readme",
  "bugs": {
    "url": "https://github.com/Kairos0922/intelligent-ui/issues"
  },
  "keywords": [
    "intelligent-ui",
    "react",
    "agent",
    "generative-ui"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@intelligent-ui/adapter": "0.2.2",
    "@intelligent-ui/core": "0.2.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
