{
  "name": "@intelligent-ui/dsh",
  "version": "0.2.0",
  "type": "module",
  "description": "DeepSeek Harness adapter for Intelligent UI: render_iui tool, keyed toolview, host theme bridge, and action round-trip.",
  "license": "MIT",
  "author": "Intelligent UI contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kairos0922/intelligent-ui.git",
    "directory": "packages/dsh"
  },
  "homepage": "https://github.com/Kairos0922/intelligent-ui#readme",
  "bugs": {
    "url": "https://github.com/Kairos0922/intelligent-ui/issues"
  },
  "keywords": [
    "intelligent-ui",
    "deepseek-harness",
    "dsh",
    "agent",
    "ui"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "vite build -c vite.server.config.ts && vite build -c vite.client.config.ts && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@intelligent-ui/adapter": "0.2.0",
    "@intelligent-ui/core": "0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "react": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
